flowchart TD
    A([用户客户端]) --> B[点开送礼面板]
    B --> C[拉取送礼列表接口]
    C --> D[返回两个礼物列表<br/>· 可显示礼物列表<br/>· 当前上架礼物列表]
    D --> E[用户选择礼物]
    E --> F[点击送礼按钮<br/>调用送礼接口]

    subgraph 送礼接口执行逻辑
        F --> G[检验参数]
        G --> H{是否拥有送礼权限}
        H -- 否 --> H1[返回无权限错误]
        H1 -.-> F
        H -- 是 --> I{1秒内送礼频率限制}
        I -- 超限 --> I1[返回频率限制错误]
        I1 -.-> F
        I -- 通过 --> J[调用钱包服务扣款]
        J --> K[创建送礼消息A<br/>写入kafka]
        K --> L[送礼接口返回结果]
    end

    subgraph 送礼消息消费逻辑
        L --> M[送礼消息A被消费]
        M --> N[写入日志表]
        N --> O[根据不同礼物类型<br/>执行不同逻辑业务<br/>· 返利<br/>· 分成<br/>· 道具奖励等]
        O --> P[推送送礼成功消息B<br/>给用户]
        P --> Q[构建送礼完成消息C<br/>写入kafka<br/>用于其他业务逻辑<br/>如用户财富值等]
    end

    Q --> R([用户客户端])
    R --> S[收到送礼成功消息B]
    S --> T[展示对应的业务逻辑]
