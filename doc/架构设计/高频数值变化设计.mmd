flowchart TD
    %% ==================== 前提背景 ====================
    N0["背景：高频数值变更若每次直接写入MySQL<br/>会导致数据量过大、性能下降、锁冲突严重<br/>方案：每timeArea秒内数据聚合写入Redis<br/>延时任务触发后批量写入MySQL"]

    %% ==================== 步骤1：数据写入Redis ====================
    subgraph S1["步骤① 数据写入Redis"]
        A([用户触发数值变更<br/>例：送礼增加魅力值]) --> B["调用聚合函数<br/>Agg(aggId, key, timeArea, score)"]
        B --> C["RPUSH agg:value:aggId:key score<br/>例：RPUSH agg:value:1:10001 100"]
    end

    C --> D{timeArea 判断}

    %% ==================== 步骤2：构建延时任务 ====================
    subgraph S2["步骤② 构建延时任务"]
        D -- "timeArea = 1<br/>当前秒即时间块" --> E1["时间块时间戳 = 当前时间戳"]
        D -- "timeArea > 1<br/>以整点为单位按timeArea分割" --> E2["计算当前时间所在时间块<br/>获取时间块起始时间戳<br/>例：timeArea=5, 当前1780000003<br/>→ 时间块起始 1780000000"]
        E1 --> F["构建延时任务Key<br/>agg:delay:aggId:key:时间块时间戳<br/>例：agg:delay:1:10001:1780000000"]
        E2 --> F
        F --> G["设置延时任务执行时间<br/>= 当前时间戳 + timeArea 秒<br/>例：1780000001"]
    end

    %% ==================== 步骤3：延时任务触发 ====================
    subgraph S3["步骤③ 延时任务触发"]
        G --> H["延时任务到达执行时间<br/>携带数据 Task{AggKey, Timestamp}"]
        H --> I["newKey = AggKey + ':snapshot' + Timestamp<br/>例：agg:value:1:10001:snapshot:1780000000"]
        I --> J{"RENAME AggKey → newKey"}
        J -- "失败（key不存在）" --> J1["无待聚合数据，直接结束"]
        J -- "成功" --> K["LLEN newKey<br/>获取列表长度"]
        K --> L{列表长度判断}
        L -- "≤ 1000" --> M["LPOP newKey 1000<br/>一次性取出全部数据"]
        L -- "> 1000" --> N["pipeline 循环执行<br/>LPOP newKey 1000<br/>直至全部数据获取完毕"]
    end

    %% ==================== 步骤4：聚合写入MySQL ====================
    subgraph S4["步骤④ 聚合写入MySQL"]
        M --> O["对获取到的所有数值<br/>进行聚合计算"]
        N --> O
        O --> P["聚合结果写入MySQL"]
    end

    %% ==================== 步骤5：清理 ====================
    subgraph S5["步骤⑤ 清理临时数据"]
        P --> Q["DEL newKey<br/>删除临时快照Key"]
        Q --> R([流程结束])
    end

    J1 --> R

    %% ==================== 备注说明 ====================
    N3["备注①：RPUSH 是原子操作<br/>保证并发场景下数据不丢失"] -.-> C
    N4["备注②：RENAME 是原子操作<br/>将聚合时间段内的数据<br/>一次性转移到快照Key<br/>避免新数据混入当前批次"] -.-> J
    N5["备注③：pipeline 批量 LPOP<br/>避免单次操作数据量过大<br/>阻塞Redis"] -.-> N
    N6["备注④：延时任务使用<br/>Redis ZSET 或专业延时队列实现<br/>如：有赞的 DelayQueue"] -.-> G

    %% 注释样式
    classDef note fill:#fff8e1,stroke:#f9a825,stroke-width:1px,stroke-dasharray:4 3;
    classDef bg fill:#e8f5e9,stroke:#4caf50,stroke-width:1px;
    class N0,N3,N4,N5,N6 note;
    class S1,S2,S3,S4,S5 bg;