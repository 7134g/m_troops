flowchart TD
    %% ==================== 背景 ====================
    N0["背景：排行榜需要解决<br/>1. 同分不同时间，按时间先后排序<br/>2. 依赖多值排序：先排A，同分再排B，<br/>B同分再排C，C同分再排D"]

    %% ==================== 方案1：Redis ZSet 单次查询 ====================
    subgraph P1["方案1 Redis ZSet 单次查询"]
        A(["写入/查询入口<br/>只查一次Redis"]) --> B["ZSet结构：<br/>key = 排行榜名称<br/>value = 用户ID<br/>score = 用户分数"]
        B --> C["构造组合分数<br/>score = 分数组合 + 9位时间戳<br/>基础长度15位=100000000000000"]
        C --> D["权重拆分逻辑<br/>(D + C×1000 + B×1000000<br/>+ A×1000000000) × 1000000000<br/>+ (当前时间戳-1000000000)<br/>例：A20,B30,C40,D100,<br/>时间戳123456789 →<br/>20030040100123456789"]
        D --> E{"同分且时间戳也相等"}
        E -- 是 --> F["按field排序<br/>field遵循ASCII码排序<br/>同位数纯数字ID越小越前"]
        E -- 否 --> G([返回排行榜])
        F --> G
    end

    %% ==================== 方案2：两个 ZSet 双次查询 ====================
    subgraph P2["方案2 双 ZSet 二次查询"]
        H(["写入入口"]) --> I["zadd 写入分数ZSet<br/>(userID → 分数)"]
        I --> J["zadd 写入时间戳ZSet<br/>(userID → 时间戳)"]
        J --> K(["读取入口"])
        K --> L["读取分数ZSet"]
        L --> M{存在相同分数}
        M -- 是 --> N["再读取时间戳ZSet<br/>按时间先后排序"]
        M -- 否 --> O([返回排行榜])
        N --> O
    end

    %% ==================== 方案3：内存 + Kafka + MySQL 双写 ====================
    subgraph P3["方案3 内存 + Kafka + MySQL 双写<br/>每台服务器一份排行榜<br/>带锁的map结构M"]
        Q(["接口请求过来"]) --> R["先写入Kafka消息"]
        R --> S["消费Kafka<br/>更新内存排行榜M<br/>(独立消费组，<br/>每台服务器都收到数据)"]
        S --> T["起协程异步写入MySQL"]
        T --> U(["返回结果"])
    end

    %% ==================== 方案3 快照一致性细节 ====================
    subgraph P4["方案3 快照一致性（最强一致性）"]
        V(["A服务消费消息时"]) --> W["更新MySQL排行榜数据<br/>+ 记录每个游戏最新Kafka Offset<br/>+ 更新内存排行榜"]
        W --> X["B服务启动时<br/>读取MySQL快照<br/>+ 读取当前记录的Offset"]
        X --> Y["从 Offset+1 开始消费<br/>保证不丢数据"]
    end

    %% ==================== 备注说明 ====================
    N1["备注①：ZSet 底层跳表<br/>score 按 double 存储<br/>±16长度可保证精度"] -.-> B
    N2["备注②：基础长度15位<br/>作为score最大值长度<br/>分数和时间戳的值<br/>都落在其上"] -.-> C
    N3["备注③：方案1 优缺点<br/>计算量高一点<br/>网络IO开支小"] -.-> G
    N4["备注④：方案2 优缺点<br/>网络IO开支大一点<br/>计算量小一点<br/>有概率时间戳不正确<br/>(同字段同时写入两条分数时<br/>时间戳有概率写入旧时间)"] -.-> N
    N5["备注⑤：方案3 内存方案<br/>多机器相同排行榜<br/>双写MySQL + 原子性快照"] -.-> R
    N6["备注⑥：每台消费排行榜的服务器<br/>都是独立消费组，<br/>确保每台机器数据相同"] -.-> S

    %% 注释样式
    classDef note fill:#fff8e1,stroke:#f9a825,stroke-width:1px,stroke-dasharray:4 3;
    classDef bg fill:#e8f5e9,stroke:#4caf50,stroke-width:1px;
    class N0,N1,N2,N3,N4,N5,N6 note;
    class P1,P2,P3,P4 bg;
