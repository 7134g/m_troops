flowchart TD
    %% ==================== 背景：需要解决的问题 ====================
    N0["背景：排行榜需要支持多维排序<br/>问题①：同分、不同时间 → 按时间先后顺序排序<br/>问题②：依赖多个值排序 → 先排A，A同再排B<br/>B同再排C，C同再排D"]

    %% ==================== 方案一：只查一次 redis zset ====================
    subgraph S1["方案一：只查一次 redis zset"]
        direction TB

        %% 写入流程
        A1["计算组合 score<br/>score = (D + C*1000 + B*1000000 + A*1000000000)*1000000000<br/>+ 9位时间戳（当前时间戳 - 1000000000）"]
        A1 --> A2["ZADD 排行榜名称 userID score<br/>例：ZADD rank:xxx 20030040100123456789 10001"]
        A2 --> A3["查询排行榜<br/>ZREVRANGE 按分数倒序读取"]

        %% 同分处理
        A3 --> A4{"同分且时间戳也相同？"}
        A4 -- "否" --> A5["直接按 score 排序展示"]
        A4 -- "是" --> A6["按 field 排序（ASCII 码）<br/>同位数纯数字 id 越小越靠前"]

        %% 备注说明
        N11["说明①：基础长度为 15 位<br/>作为 score 的最大值长度<br/>分数和时间戳的值都落在这上面"] -.-> A1
        N12["说明②：分数按权重分割<br/>例：A:20 B:30 C:40 D:100<br/>9位时间戳=123456789<br/>→ score=20030040100123456789"] -.-> A1
        N13["说明③：redis zset 底层为 double<br/>±16 位长度可保证精度"] -.-> A1
        N14["优缺点：计算量高一点<br/>网络 IO 开销小"] -.-> A3
    end

    %% ==================== 方案二：查两次 redis ====================
    subgraph S2["方案二：查两次 redis"]
        direction TB

        %% 写入流程
        B1["写入：先 ZADD 分数 zset<br/>（userID, 分数）"] --> B2["写入：再 ZADD 时间戳 zset<br/>（userID, 时间戳）"]
        B2 --> B3["读取：先读分数 zset"]
        B3 --> B4{"存在相同分数？"}
        B4 -- "否" --> B5["直接按分数排名展示"]
        B4 -- "是" --> B6["再读时间戳 zset<br/>按时间先后排序"]

        %% 备注说明
        N21["优缺点：网络 IO 开销大一点<br/>计算量小一点"] -.-> B3
        N22["风险：时间戳有概率不正确<br/>同时写入同一个 field 两条分数时<br/>时间戳有概率写入旧时间"] -.-> B2
    end

    %% ==================== 方案三：内存方案（多机器相同排行榜） ====================
    subgraph S3["方案三：内存方案（多机器相同排行榜）"]
        direction TB

        %% 双写 MySQL + 原子性快照（核心思想）
        subgraph S31["双写 MySQL + 原子性快照（最强一致性）"]
            direction TB
            D1["A服务：消费消息时<br/>① 更新 MySQL 排行榜数据<br/>② 记录每个游戏最新 Kafka Offset<br/>③ 更新内存排行榜"]
            D2["B服务：启动时<br/>① 读取 MySQL 快照<br/>② 读取当前记录的 Offset<br/>③ 从 Offset+1 开始消费"]
        end

        %% 请求处理流程
        C1([接口请求过来]) --> C2["先写入 Kafka 消息"]
        C2 --> C3["消费 Kafka 更新内存排名<br/>写入带锁的 map 结构体 M"]
        C3 --> C4["再起协程异步写入 MySQL"]

        %% 备注说明
        N31["说明①：每台服务器各保存一份排行榜数据<br/>数据结构为带锁的 map 结构体 M"] -.-> C3
        N32["说明②：每台消费排行榜数据的服务器<br/>都是独立消费组<br/>排行榜数据产生时每台都会收到并写入 M<br/>确保每台机器数据相同"] -.-> C3
        N33["说明③：分数的变更通过 Kafka 读取写入 M"] -.-> C2
    end

    %% 注释样式
    classDef note fill:#fff8e1,stroke:#f9a825,stroke-width:1px,stroke-dasharray:4 3;
    classDef bg fill:#e8f5e9,stroke:#4caf50,stroke-width:1px;
    class N0,N11,N12,N13,N14,N21,N22,N31,N32,N33 note;
    class S1,S2,S3 bg;
